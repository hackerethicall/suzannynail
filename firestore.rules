rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O cliente pode enxergar apenas ocupação sem identidade.
    match /public_slots/{slotId} {
      allow read: if true;
      allow write: if false;
    }
    match /public_blocks/{blockId} {
      allow read: if true;
      allow write: if false;
    }
    match /services/{serviceId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }
    // Dados sensíveis são acessados pelo backend com Firebase Admin.
    match /appointments/{appointmentId} { allow read, write: if false; }
    match /blocks/{blockId} { allow read, write: if false; }
    match /team/{memberId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
